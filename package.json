{
  "name": "learntrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "emulators": "firebase emulators:start --project demo-learntrack --import=.emulator-data --export-on-exit=.emulator-data",
    "local": "concurrently -k -n firebase,web \"npm run emulators\" \"npm run dev\"",
    "test": "node --test tests/domain.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-learntrack-rules --config firebase.test.json \"node --test tests/rules.test.mjs\"",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "firebase": "^12.18.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.28.2",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
